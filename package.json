{
  "name": "childinfo-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/ai-guide-router.test.mjs",
    "test:ai": "node --test tests/ai-guide-router.test.mjs",
    "guard:data": "node scripts/data-guard.mjs",
    "guard:facilities": "node scripts/facilities/build-runtime.mjs && node scripts/facilities/check-v2.mjs",
    "facilities:audit": "node scripts/facilities/audit-legacy.mjs --write",
    "facilities:import:childcare": "node scripts/facilities/import-childcare.mjs",
    "facilities:import": "node scripts/facilities/import-public-source.mjs",
    "facilities:sync:keyless": "node scripts/facilities/sync-keyless-standard.mjs",
    "facilities:sync:files": "node scripts/facilities/sync-file-sources.mjs",
    "facilities:sync:keyed": "node scripts/facilities/sync-keyed-api.mjs",
    "facilities:build:runtime": "node scripts/facilities/build-runtime.mjs",
    "build": "npm run guard:data && npm run guard:facilities && vite build",
    "preview": "vite preview",
    "ait:build": "npx ait build",
    "ait:deploy": "npx ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.5.1",
    "@supabase/supabase-js": "^2.103.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.2"
  }
}
